# Node 22 LTS and Yarn 1.22.22; public values are embedded by yarn build.
# Supply real deployment URLs before building; never put secrets here.
NODE_ENV=production
PORT=3000
REACT_APP_API_URL=https://gymflow.example
REACT_APP_API_GRAPHQL_URL=https://gymflow.example/graphql
# Legacy/optional; no active WebSocket connection is configured by the MVP.
# REACT_APP_API_WS=wss://gymflow.example
