# Node 22.x and Yarn 1.22.22. Examples only; never put secrets in public values.
# Next build/start use production mode. Install build dependencies before building.
NODE_ENV=production
# Runtime listen port; may also be set with yarn start --port 3000.
PORT=3000
# REQUIRED BUILD-TIME values, explicitly exposed by next.config.js env despite the REACT_APP_ prefix.
# Supply the canonical public HTTPS origin and GraphQL URL before yarn build.
# Changing these only at runtime does not rewrite already-built browser assets; rebuild for another origin.
REACT_APP_API_URL=https://gymflow.example
REACT_APP_API_GRAPHQL_URL=https://gymflow.example/graphql
# Legacy/optional; no active WebSocket connection is configured by the MVP.
# REACT_APP_API_WS=wss://gymflow.example
